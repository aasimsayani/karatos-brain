{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aasimsayani/karatos-brain/secrets/manifest.schema.json",
  "title": "Brain A secrets manifest",
  "description": "Describes every secret and setting a Brain A instance needs, without any values. Humans, scripts and AI agents in any language read this file to know what to collect, where to get it, how to check it and how to generate it.",
  "type": "object",
  "required": [
    "version",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "description",
        "requiredFor",
        "howToGet"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "kind": {
          "enum": [
            "secret",
            "config"
          ],
          "description": "secret values are never printed, logged or committed; config values are safe to show"
        },
        "description": {
          "type": "string"
        },
        "requiredFor": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(core|instance|migrations|integration:[a-z_]+)$"
          },
          "description": "core and instance are always required to run; integration:<name> only when that integration is turned on"
        },
        "pattern": {
          "type": "string",
          "description": "ECMAScript regex the value must fully match"
        },
        "example": {
          "type": "string",
          "description": "A fake, safe-to-publish example value"
        },
        "generate": {
          "type": "object",
          "required": [
            "method",
            "bytes"
          ],
          "additionalProperties": false,
          "properties": {
            "method": {
              "enum": [
                "random_hex",
                "random_base64url"
              ]
            },
            "bytes": {
              "type": "integer",
              "minimum": 16
            }
          },
          "description": "Present when the value should be generated by a machine, never asked from a person"
        },
        "howToGet": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Plain-language steps a non-technical owner can follow"
        },
        "docsUrl": {
          "type": "string"
        },
        "rotateEveryDays": {
          "type": "integer",
          "minimum": 1
        },
        "optional": {
          "type": "boolean",
          "description": "Never blocks readiness; the instance runs in a reduced mode without it"
        }
      }
    }
  }
}
