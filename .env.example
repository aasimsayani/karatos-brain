# Copy to .env.local and fill in. Never commit real values; this repo is public.

# Required
ORGANIZATION_ID=fuse-jewelry
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Needed only for server-side jobs
SUPABASE_SERVICE_ROLE_KEY=
# Needed only for npm run db:migrate (Project Settings > Database > Connection string)
SUPABASE_DB_URL=

# Optional integrations: leave blank until you connect them
ANTHROPIC_API_KEY=
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
HUBSPOT_ACCESS_TOKEN=
SLACK_BOT_TOKEN=
MONDAY_API_TOKEN=
