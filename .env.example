# Copy to .env.local, then run: npm run secrets:setup
# secrets/manifest.json explains every value. Never commit real values; this repo is public.

# Instance
INSTANCE_NAME=
ORGANIZATION_ID=
ENABLED_INTEGRATIONS=
# Minutes between sync rounds; empty means 60
SYNC_INTERVAL_MINUTES=
# Scheduled reasoning, on or off; empty means on
REASON_SCHEDULE=
# Longest gap in minutes between scheduled reasoning runs; empty means 60
REASON_INTERVAL_MINUTES=
# Days raw vendor data is kept before it is cleared; empty means 30
RAW_RETENTION_DAYS=
# The store's IANA time zone; empty means America/New_York
STORE_TIME_ZONE=
# When the store is open, e.g. mon-fri 10:00-18:00; sat 10:00-17:00; sun closed. Empty means mon-sat 10:00-18:00; sun closed
STORE_HOURS=
# Comma-separated YYYY-MM-DD days the store is shut, e.g. 2026-11-26,2026-12-25
STORE_CLOSED_DATES=
# Open hours a customer's message waits before clienteling raises it; empty means 4
AWAITING_REPLY_HOURS=
INSTANCE_API_KEY=
# Optional support access: diagnostic routes only, never business data. Must differ from INSTANCE_API_KEY.
SUPPORT_API_KEY=
WEBHOOK_SIGNING_SECRET=
DOC_REGISTRY_IDS=
ENABLED_DEPARTMENTS=
# Empty keeps every integration read-only. Example: shopify:adjust_inventory
ENABLED_WRITES=

# This client's own Supabase project
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Integrations: only needed once listed in ENABLED_INTEGRATIONS
ANTHROPIC_API_KEY=
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Only for a store with an older custom app made in the admin, instead of the two above
SHOPIFY_ADMIN_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
HUBSPOT_ACCESS_TOKEN=
SLACK_BOT_TOKEN=
MONDAY_API_TOKEN=
