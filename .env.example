# Copy to .env.local, then run: npm run secrets:setup
# secrets/manifest.json explains every value. Never commit real values; this repo is public.

# Instance
INSTANCE_NAME=
ORGANIZATION_ID=
ENABLED_INTEGRATIONS=
INSTANCE_API_KEY=
WEBHOOK_SIGNING_SECRET=
DOC_REGISTRY_IDS=
ENABLED_DEPARTMENTS=
# Empty keeps every integration read-only. Example: shopify:adjust_inventory
ENABLED_WRITES=

# This client's own Supabase project
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Integrations: only needed once listed in ENABLED_INTEGRATIONS
ANTHROPIC_API_KEY=
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
HUBSPOT_ACCESS_TOKEN=
SLACK_BOT_TOKEN=
MONDAY_API_TOKEN=
