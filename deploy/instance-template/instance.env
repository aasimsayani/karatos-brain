# Non-secret settings for this client. Secrets go in the host's secret store, never here.
INSTANCE_NAME=Client Name
ORGANIZATION_ID=client-name
ENABLED_INTEGRATIONS=
SYNC_INTERVAL_MINUTES=60
REASON_SCHEDULE=on
REASON_INTERVAL_MINUTES=60
FEEDBACK_COOLDOWN_DAYS=14
RAW_RETENTION_DAYS=30
STORE_TIME_ZONE=America/New_York
# Days then 24-hour times or closed; see docs/deployment/instances.md#store-hours
STORE_HOURS=mon-sat 10:00-18:00; sun closed
STORE_CLOSED_DATES=
AWAITING_REPLY_HOURS=4
# Bench jobs; see docs/departments/bench.md
BENCH_STAGE_LIMIT_DAYS=
BENCH_METAL_LOSS_PERCENT=3
# Production planning; see docs/departments/production.md
BENCH_LABOR_RATE=45
BENCH_DAILY_HOURS=6
DOC_REGISTRY_IDS=
ENABLED_DEPARTMENTS=
MIGRATE_ON_START=true
