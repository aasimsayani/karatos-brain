{
  "name": "@karatos/demo",
  "version": "0.1.0",
  "description": "A made-up jewelry store run through the real connectors and brain, for the public demo dashboard.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@karatos/connector-testkit": "0.1.0",
    "@karatos/connectors": "0.1.0",
    "@karatos/core": "0.1.0",
    "@karatos/retail": "0.1.0",
    "@karatos/server": "0.1.0"
  }
}
