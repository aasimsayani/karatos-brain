{
  "name": "karatos-brain",
  "version": "0.1.0",
  "private": true,
  "description": "Brain A: the open-core operational intelligence layer for jewelry businesses (Fuse Jewelry, KaratOS).",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run build -w @karatos/core -w @karatos/store-postgres -w @karatos/retail -w @karatos/connector-testkit -w @karatos/connectors && npm run typecheck --workspaces && tsc -p tsconfig.json",
    "test": "vitest run",
    "env:check": "node --import tsx scripts/env-check.ts",
    "supabase:check": "node --import tsx scripts/supabase-check.ts",
    "db:migrate": "node --import tsx scripts/db-migrate.ts",
    "secrets:scan": "node scripts/secrets-scan.mjs",
    "docs:watch": "node --import tsx scripts/docs-watch.ts",
    "sandbox:run": "node --import tsx scripts/sandbox-run.ts",
    "test:coverage": "vitest run --coverage",
    "secrets:plan": "node --import tsx scripts/secrets.ts plan",
    "secrets:setup": "node --import tsx scripts/secrets.ts setup",
    "changelog:check": "node --import tsx scripts/changelog-cli.ts check",
    "changelog:collect": "node --import tsx scripts/changelog-cli.ts collect",
    "progress:write": "node --import tsx scripts/progress-cli.ts write",
    "progress:check": "node --import tsx scripts/progress-cli.ts check",
    "registry:write": "node --conditions=source --import tsx scripts/registry-cli.ts write",
    "registry:check": "node --conditions=source --import tsx scripts/registry-cli.ts check"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
