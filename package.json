{
  "name": "karatos-brain",
  "version": "0.1.0",
  "private": true,
  "description": "Brain A: the open-core operational intelligence layer for jewelry businesses (Fuse Jewelry, KaratOS).",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces",
    "env:check": "node --import tsx scripts/env-check.ts",
    "secrets:scan": "node scripts/secrets-scan.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
