{
  "name": "karatos-brain",
  "version": "0.1.0",
  "private": true,
  "description": "Brain A: the open-core operational intelligence layer for jewelry businesses (Fuse Jewelry, KaratOS).",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run build -w @karatos/core -w @karatos/store-postgres && npm run typecheck --workspaces && tsc -p tsconfig.json",
    "test": "vitest run",
    "env:check": "node --import tsx scripts/env-check.ts",
    "supabase:check": "node --import tsx scripts/supabase-check.ts",
    "db:migrate": "node --import tsx scripts/db-migrate.ts",
    "secrets:scan": "node scripts/secrets-scan.mjs",
    "test:coverage": "vitest run --coverage",
    "secrets:plan": "node --import tsx scripts/secrets.ts plan",
    "secrets:setup": "node --import tsx scripts/secrets.ts setup"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
